<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Not wired into project.yml yet, on purpose.

  Signing a build against an iCloud container that does not exist in the developer account
  fails, so this file stays inert until `iCloud.com.calebl.elbert` is registered (spec section 10,
  item 1). Enabling it is documented in ios/README.md and is two edits: reference this file from
  the Elbert target in project.yml, and add ELBERT_CLOUDKIT to SWIFT_ACTIVE_COMPILATION_CONDITIONS.

  Only the private database is used. There is no public or shared CloudKit data in Elbert.
-->
<plist version="1.0">
<dict>
	<key>com.apple.developer.icloud-container-identifiers</key>
	<array>
		<string>iCloud.com.calebl.elbert</string>
	</array>
	<key>com.apple.developer.icloud-services</key>
	<array>
		<string>CloudKit</string>
	</array>
	<key>aps-environment</key>
	<string>development</string>
</dict>
</plist>
